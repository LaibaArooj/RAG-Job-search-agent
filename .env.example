# Copy to .env and fill in. Never commit .env.

# --- Flask ---
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# --- MongoDB Atlas ---
# Atlas → Connect → Drivers → Python. Replace <password> with the real one.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=job_search_agent

# --- Adzuna (250 requests/day free) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# --- Groq (Llama 3 8B-instant) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Remotive: no key required ---
